    "push_to_hub": false,
    "policy_kwargs": {
      "use_tanh_squash": true,
      "std_min": 1e-05,
      "std_max": 10.0,
      "init_final": 0.05,
      "action_scale": 0.5
    }
  },
  "algorithm": {
    "type": "sac",
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "temperature_lr": 0.0003,
    "discount": 0.97,
    "temperature_init": 0.01,
    "num_critics": 2,
    "utd_ratio": 1,
    "policy_update_freq": 1,
    "grad_clip_norm": 40.0,
    "target_entropy": -2.0
  },
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_sim_follower",
      "id": "so101_sim",
      "xml_path": "Simulation/SO101/so101_new_calib.xml",
      "fps": 10,
      "show_viewer": true,
      "viewer_azimuth_deg": 0.0,
      "cube_yaw_range_deg": 15.0
    },
    "teleop": {
      "type": "so101_leader",
      "id": "my_awesome_leader_arm",
      "port": "/dev/ttyACM1",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader_clutch",
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": true,
        "add_ee_pose_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.front": [
            0,
            0,
            379,
            575
          ],
          "observation.images.wrist": [
            0,
            0,
            480,
            640
          ]
        },
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": [
          0.0,
          0.0,
          0.0,
          90.0,
          0.0,
          5.0
        ],
        "reset_time_s": 2.0,
        "control_time_s": 30.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "Simulation/SO101/so101_new_calib_camera.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [
            0.0673,
            -0.1982,
            0.005
          ],
          "max": [
            0.3155,
            0.2947,
            0.1477
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.02,
          "y": 0.02,
          "z": 0.02
        }
      },
      "reward_classifier": null,
      "max_gripper_pos": 30,
      "staged_reward": {
        "grasp_reward": 0.1,
        "lift_reward": 0.3,
        "grasp_min_gripper_pos": 2.5,
        "lift_height": 0.05,
        "discount": 0.97
      }
    },
    "features": {
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [
          18
        ]
      },
      "action": {
        "type": "ACTION",
        "shape": [
          3
        ]
      }
    },
    "features_map": {
      "observation.images.front": "observation.images.front",
      "observation.images.wrist": "observation.images.wrist",
      "observation.state": "observation.state",
      "action": "action"
    }
  },
  "display_mode": "rerun",
  "display_compressed_images": false,
  "runs_dir": "outputs/train/HIL_SERL",
  "discrete_action_epsilon": 0.1
}
