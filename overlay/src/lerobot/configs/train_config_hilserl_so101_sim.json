{
  "output_dir": null,
  "job_name": "hilserl_so101_sim",
  "resume": false,
  "seed": 1000,
  "num_workers": 4,
  "batch_size": 128,
  "log_freq": 1,
  "save_checkpoint": true,
  "save_freq": 2000,
  "wandb": {
    "enable": true,
    "project": "hilserl_so101",
    "disable_artifact": true
  },
  "dataset": {
    "repo_id": "YOUR_HF_USER/so101_hilserl_sim_sac",
    "root": null,
    "use_imagenet_stats": false,
    "exclude_episodes": [
      8
    ]
  },
  "policy": {
    "type": "gaussian_actor",
    "device": "cuda",
    "storage_device": "cpu",
    "vision_encoder_name": "lerobot/resnet10",
    "freeze_vision_encoder": true,
    "image_encoder_hidden_dim": 32,
    "shared_encoder": true,
    "num_discrete_actions": 3,
    "online_steps": 1000000,
    "online_buffer_capacity": 8000,
    "offline_buffer_capacity": 5000,
    "online_step_before_learning": 100,
    "input_features": {
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [
          18
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          3
        ]
      }
    },
    "normalization_mapping": {
      "VISUAL": "MEAN_STD",
      "STATE": "MIN_MAX",
      "ENV": "MIN_MAX",
      "ACTION": "MIN_MAX"
    },
