{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_sim_follower",
      "id": "so101_sim",
      "xml_path": "Simulation/SO101/so101_new_calib.xml",
      "fps": 10,
      "show_viewer": true,
      "cube_yaw_range_deg": 15.0
    },
    "teleop": {
      "type": "so101_leader",
      "id": "my_awesome_leader_arm",
      "port": "/dev/ttyACM1",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": true,
        "add_ee_pose_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.front": [
            0,
            0,
            379,
            575
          ],
          "observation.images.wrist": [
            0,
            0,
            480,
            640
          ]
        },
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": [
          0.0,
          0.0,
          0.0,
          90.0,
          0.0,
          5.0
        ],
        "reset_time_s": 5.0,
        "control_time_s": 30.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "Simulation/SO101/so101_new_calib_camera.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [
            0.0673,
            -0.1982,
            0.005
          ],
          "max": [
            0.3155,
            0.2947,
            0.1477
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.02,
          "y": 0.02,
          "z": 0.02
        }
      },
      "reward_classifier": null,
      "max_gripper_pos": 30
    }
  },
  "dataset": {
    "repo_id": "YOUR_HF_USER/so101_hilserl_sim_sac",
    "task": "pick up the black cubic to the circle",
    "root": null,
    "num_episodes_to_record": 20,
    "replay_episode": null,
    "push_to_hub": false,
    "no_stamp": true
  },
  "mode": "record",
  "device": "cuda",
  "display_mode": "rerun"
}
